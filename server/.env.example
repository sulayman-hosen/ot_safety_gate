# Copy to server/.env for MongoDB / SMART operation. npm run demo needs no env file.
PORT=5000
SERVER_HOST=127.0.0.1
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/ot_safety_gate
STORAGE_MODE=mongo
DEMO_ENABLED=true
# Generate with npm run key; use a secret manager for a real installation.
SESSION_ENCRYPTION_KEY=
SESSION_TTL_MINUTES=30

# Register this client with your EHR. Exact FHIR base, not its login page.
SMART_FHIR_BASE=
SMART_CLIENT_ID=
# none (sandbox/public client), client_secret_basic, or client_secret_post
SMART_AUTH_METHOD=none
SMART_CLIENT_SECRET=
# Comma-separated HTTPS origins used by the EHR authorization server.
# The FHIR origin is allowed automatically. No wildcard hosts.
SMART_AUTH_ORIGINS=
# Pin the expected OIDC issuer and its JWKS endpoint for verified clinician identity.
SMART_OIDC_ISSUER=
SMART_JWKS_URI=
SMART_SCOPES=openid fhirUser patient/Patient.r patient/Encounter.r patient/ServiceRequest.rs patient/Condition.rs patient/Consent.rs patient/DocumentReference.rs patient/Provenance.rs patient/Observation.rs patient/AllergyIntolerance.rs patient/MedicationRequest.rs user/Practitioner.r
# Exact, verified FHIR Practitioner IDs allowed to attest. Empty = view-only.
SMART_REVIEWER_IDS=
# Set EHR_FRAME_ORIGINS in client/.env.local to permit trusted iframe origins.
# true only on HTTPS when your EHR needs third-party iframe cookies.
EMBEDDED_COOKIE=false

# Example clinical rules are for synthetic demonstrations only.
# Set these ONLY after replacing/reviewing server/src/config/clinicalPolicy.js locally.
CLINICAL_POLICY_APPROVED=false
CLINICAL_POLICY_APPROVER=
